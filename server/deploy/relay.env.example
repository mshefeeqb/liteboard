# Copy to relay.env and fill in. Never commit relay.env.

# Postgres for saved boards. Tables are created on start.
# Supabase: use the session pooler (port 5432) or the direct connection,
# not the transaction pooler (port 6543).
# TLS: download the database CA certificate to certs/db-ca.crt and keep
#   ?sslmode=verify-full&sslrootcert=/certs/db-ca.crt
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/certs/db-ca.crt

# Connections the relay keeps open to Postgres. 5 is plenty for one relay.
DATABASE_POOL_MAX=5

# false when the tables already exist and the relay connects as a role that
# may only read and write them (recommended; see DEPLOY.md).
DATABASE_MIGRATE=true

# The HS256 secret your app signs board tokens with (same value on both sides).
# Generate one with: openssl rand -base64 48
LITEBOARD_JWT_SECRET=
