{
  "name": "liteboard",
  "version": "0.1.3",
  "description": "Lightweight, fast, embeddable whiteboard for slow networks and low-end devices.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "fonts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./excalidraw": {
      "types": "./dist/excalidraw.d.ts",
      "import": "./dist/excalidraw.js",
      "require": "./dist/excalidraw.cjs"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js",
      "require": "./dist/sync.cjs"
    },
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite demo --config demo/vite.config.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p server",
    "size": "npm run build && size-limit",
    "relay": "cd server && npm run build && node dist/bin.js",
    "smoke": "vite-node scripts/smoke.ts --",
    "setup": "npm install && npm --prefix server install",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "whiteboard",
    "canvas",
    "drawing",
    "collaboration",
    "lightweight"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshefeeqb/liteboard.git"
  },
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ],
      "sync": [
        "dist/sync.d.ts"
      ],
      "excalidraw": [
        "dist/excalidraw.d.ts"
      ]
    }
  }
}
